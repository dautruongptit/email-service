{
  "name": "email-service",
  "version": "1.0.0",
  "description": "Centralized email service with React Email templates, supporting Resend and Brevo providers",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
