# Server
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Resend (for CoupleStory)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Brevo (for Nino)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxx

# API Clients - JSON array
# Each client: id, name, keyHash (SHA-256 of API key), provider, from, replyTo, branding, allowedTemplates, allowedLinkDomains, rateLimitPerMinute
API_CLIENTS='[{"id":"couplestory","name":"CoupleStory","keyHash":"<sha256>","provider":"resend","fallbackProvider":"brevo","from":"CoupleStory <no-reply@couplestory.site>","replyTo":"support@couplestory.site","branding":{"appName":"CoupleStory","accentColor":"#E8477C","logoUrl":"https://couplestory.site/logo.png"},"allowedTemplates":["otp-code","security-notice","couplestory/*"],"allowedLinkDomains":["couplestory.site","*.couplestory.site"],"rateLimitPerMinute":60},{"id":"nino","name":"Nino","keyHash":"<sha256>","provider":"brevo","from":"Nino <no-reply@nino.thongtinchinhhieu.site>","replyTo":"support@thongtinchinhhieu.site","branding":{"appName":"Nino","accentColor":"#2563EB","logoUrl":""},"allowedTemplates":["otp-code","security-notice","welcome"],"allowedLinkDomains":["thongtinchinhhieu.site","*.thongtinchinhhieu.site"],"rateLimitPerMinute":60}]'
